# Server
DATABASE_URL=postgres://ensure:ensure_local_only@localhost:5432/ensure
# Generate per developer: openssl rand -hex 32 (never share or commit)
SESSION_SECRET=
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
# Public read endpoint; provider URLs containing API keys are secrets.
# For GitHub Actions, set as a repository Variable named SEPOLIA_RPC_URL (not a secret).
SEPOLIA_RPC_URL=
# Fresh funded Sepolia test wallet; hidden input in setup-server.sh
PUBLISHER_PRIVATE_KEY=
# CI preview publisher (preview resolver only). Used by scripts/ci-publish-preview.ts and GitHub Actions secret CI_PRIVATE_KEY.
CI_PRIVATE_KEY=
# Server-side Pinata JWT with Admin scopes; never exposed to web/
PINATA_JWT=

# Arkiv Rabdi release history (dedicated test wallet; never expose the private key to web/)
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
ARKIV_WRITER_ADDRESS=
ARKIV_RETENTION_DAYS=90
ARKIV_SOURCE_CONFIRMATIONS=1

# From `pnpm setup-ens platform <name.eth>`
PLATFORM_NAME=
PLATFORM_REGISTRY=
PLATFORM_RESOLVER=

# docker (default), or local for development without Docker. local is refused in production.
BUILD_SANDBOX=docker
BUILDER_IMAGE=ensure-builder
MAX_CONCURRENT_DEPLOYS=3

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Google login, optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bot, optional
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# On-chain deploy log, optional. From `forge script script/Deploy.s.sol`
DEPLOY_REGISTRY=

# IPNS through a Kubo node, optional
KUBO_API_URL=

# One-time setup script only; setup-server.sh clears SETUP_PRIVATE_KEY afterward.
# Never give a server process the setup/owner key.
SETUP_PRIVATE_KEY=
PUBLISHER_ADDRESS=

# Contract verification
ETHERSCAN_API_KEY=
