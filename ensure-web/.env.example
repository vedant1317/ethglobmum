# Existing deployment backend (backend/, Express). Defaults to http://localhost:3001.
VITE_API_URL=
# Optional separate OAuth backend; defaults to VITE_API_URL.
VITE_AUTH_API_URL=

# Optional Sepolia JSON-RPC endpoint. Never place wallet keys or service secrets here.
VITE_SEPOLIA_RPC_URL=

# Public gateway only; no Pinata JWT belongs in this browser app.
VITE_PINATA_GATEWAY=
VITE_IPFS_GATEWAYS=

# Optional earlier range start for complete event history; by default, starts at the last recorded owner promotion.
VITE_HISTORY_FROM_BLOCK=

# Optional self-reporting CID for this deployed frontend build.
VITE_APP_BUILD_CID=
